{
  "name": "linearcard-monorepo",
  "private": true,
  "packageManager": "npm@11.10.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run kill-ports && turbo run dev",
    "dev:clean": "npm run kill-ports && turbo run dev",
    "kill-ports": "npx -y kill-port 3000 3001 || true",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "googleapis": "^180.0.0"
  }
}
