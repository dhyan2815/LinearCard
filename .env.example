# ==============================================================================
# LinearCard Environment Configuration Template
# Copy this file to .env and populate with your actual secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Wallet Integration (Service Account & Issuer)
# ------------------------------------------------------------------------------
# Google Wallet Issuer ID from Google Pay & Wallet Console
ISSUER_ID=3388000000023177673

# Optional alias/override for ISSUER_ID
GOOGLE_WALLET_ISSUER_ID=3388000000023177673

# Service account client email associated with Google Wallet API
GOOGLE_CLIENT_EMAIL=wallet-service-account@linearcard-project.iam.gserviceaccount.com

# Service account RSA private key (PEM format, with literal \n escapes or quoted newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign and verify administrative session JWTs and tokens
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# ------------------------------------------------------------------------------
# Supabase Database Configuration
# ------------------------------------------------------------------------------
# URL of your Supabase project (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://ovdpzlqejiyfbgfampap.supabase.co

# Alias for NEXT_PUBLIC_SUPABASE_URL used in backend services
SUPABASE_URL=https://ovdpzlqejiyfbgfampap.supabase.co

# Privileged Supabase Service Role Key (bypasses Row-Level Security for backend operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Application & Service URLs
# ------------------------------------------------------------------------------
# Base public URL of the web frontend (used for customer redirects and pass links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Base URL of the NestJS API backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Allowed frontend origin for CORS in the NestJS API
FRONTEND_URL=http://localhost:3000

# Server port for the NestJS API application (defaults to 3001)
PORT=3001

# ------------------------------------------------------------------------------
# WhatsApp Integration (WAHA - WhatsApp HTTP API)
# ------------------------------------------------------------------------------
# Base URL for the self-hosted or managed WAHA instance
WAHA_BASE_URL=http://localhost:3002

# Secret API key for authenticating with WAHA
WAHA_API_KEY=your_waha_api_key_here

# Active WAHA session name
WAHA_SESSION=default

# ------------------------------------------------------------------------------
# Vercel Deployment Variables (Automatically populated in Vercel environments)
# ------------------------------------------------------------------------------
# Deployment URL generated by Vercel (e.g. linearcard-xyz.vercel.app)
VERCEL_URL=

# Public Vercel URL accessible on client-side
NEXT_PUBLIC_VERCEL_URL=

# Branch preview deployment URL
NEXT_PUBLIC_VERCEL_BRANCH_URL=

# Deployment environment: 'production', 'preview', or 'development'
NEXT_PUBLIC_VERCEL_ENV=development
